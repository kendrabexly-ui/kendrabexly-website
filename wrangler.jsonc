{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kendrabexly",
  "main": "src/index.js",
  "compatibility_date": "2026-09-17",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kendrabexly-db",
      "database_id": "ffc0149a-0694-4164-8b82-f676783daa98"
    }
  ]
}
