// deployment-refresh: 2026-09-25
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kendrabexly",
  "main": "src/index.js",
  "compatibility_date": "2026-09-17",
  "keep_vars": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/portal*", "/request*", "/admin", "/admin.html", "/admin-request", "/admin-request.html", "/admin-emails", "/admin-emails.html"],
    "not_found_handling": "single-page-application"
  },

  "ai": {
    "binding": "AI"
  },

  "r2_buckets": [
    {
      "binding": "ID_DOCUMENTS",
      "bucket_name": "kendra-private-id-documents"
    }
  ],

  "triggers": {
    "crons": ["* * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kendrabexly-db",
      "database_id": "ffc0149a-0694-4164-8b82-f676783daa98"
    }
  ]
}
