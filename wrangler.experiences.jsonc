{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kendrabexly-experiences",
  "main": "src/experiences-preview.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
